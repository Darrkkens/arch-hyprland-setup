@theme "~/.config/rofi/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color: #e8e8ea;
}

window {
    width: 78%;
    height: 76%;
    location: center;
    anchor: center;
    fullscreen: false;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background-color: rgba(10, 11, 16, 0.96);
    padding: 14px;
}

mainbox {
    spacing: 10px;
    children: [inputbar, listview];
}

inputbar {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 8px 12px;
    spacing: 8px;
    children: [prompt, entry];
}

prompt {
    text-color: #cba6f7;
    font: "JetBrainsMono Nerd Font Bold 10";
}

entry {
    text-color: #f5f5f7;
    placeholder: "Escolha um wallpaper...";
    placeholder-color: rgba(255,255,255,0.35);
}

listview {
    columns: 3;
    lines: 3;
    cycle: false;
    dynamic: true;
    scrollbar: true;
    fixed-height: true;
    fixed-columns: true;
    spacing: 8px;
    padding: 2px 8px 2px 2px;
}

scrollbar {
    width: 5px;
    border-radius: 8px;
    background-color: rgba(255,255,255,0.05);
    handle-width: 5px;
    handle-color: rgba(175,198,255,0.62);
}

element {
    orientation: vertical;
    children: [element-icon];
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    padding: 0px;
    spacing: 0px;
}

element normal.normal {
    background-color: rgba(255, 255, 255, 0.04);
}

element selected.normal {
    background-color: rgba(175,198,255,0.16);
    border: 1px;
    border-color: rgba(175,198,255,0.7);
}

element-icon {
    expand: true;
    size: 220px;
    border-radius: 10px;
}

element-text {
    enabled: false;
}

element selected.normal element-text {
    text-color: #ffffff;
}
